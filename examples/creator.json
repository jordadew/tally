{
  "title": "TALLY",
  "currency": "$",
  "weekStart": "monday",
  "sections": [
    { "title": "Earned in {month}", "layout": "progress", "metric": "earned", "target": 3000 },
    {
      "layout": "pair",
      "left": { "title": "▶ Today", "ticks": true, "metrics": ["planned_today", "filmed_today", "posted_today"] },
      "right": { "title": "▶ This week", "metrics": ["planned_week", "filmed_week", "posted_week", "since_post"] }
    },
    { "title": "Deals", "layout": "strip", "metrics": ["open_deals", "on_table", "replies_today", "since_reply"] },
    { "title": "Next", "layout": "list", "metrics": ["next_piece", "next_deal"] }
  ],
  "metrics": {
    "earned": {
      "label": "earned", "format": "money", "sensitive": true,
      "source": { "type": "file", "path": "demo/income.csv", "pattern": "^(?<date>\\d{4}-\\d{2}-\\d{2}),(?<source>[^,]*),(?<amount>[\\d.]+)$", "window": "month", "measure": "sum", "field": "amount" }
    },
    "planned_today":  { "label": "planned", "tone": { "green": "> 0" }, "source": { "type": "folder", "path": "demo/posts", "date": "planned_at", "window": "today" } },
    "filmed_today":   { "label": "filmed",  "tone": { "green": "> 0" }, "source": { "type": "folder", "path": "demo/posts", "date": "filmed_at", "window": "today" } },
    "posted_today":   { "label": "posted",  "tone": { "green": "> 0" }, "source": { "type": "folder", "path": "demo/posts", "date": "posted_at", "window": "today" } },
    "planned_week":   { "label": "planned", "source": { "type": "folder", "path": "demo/posts", "date": "planned_at", "window": "week" } },
    "filmed_week":    { "label": "filmed",  "source": { "type": "folder", "path": "demo/posts", "date": "filmed_at", "window": "week" } },
    "posted_week":    { "label": "posted",  "source": { "type": "folder", "path": "demo/posts", "date": "posted_at", "window": "week" } },
    "since_post": {
      "label": "since post", "format": "days", "tone": { "red": ">= 7", "amber": ">= 3", "green": ">= 0" },
      "source": { "type": "folder", "path": "demo/posts", "date": "posted_at", "measure": "days_since" }
    },
    "open_deals": {
      "label": "open", "tone": { "amber": "> 0" },
      "source": { "type": "json", "path": "demo/deals.json", "key": "deals", "where": { "status": "open" } }
    },
    "on_table": {
      "label": "on table", "format": "money", "sensitive": true, "tone": { "green": "> 0" },
      "source": { "type": "json", "path": "demo/deals.json", "key": "deals", "where": { "status": "open" }, "measure": "sum", "field": "offer" }
    },
    "replies_today": {
      "label": "sent today", "tone": { "green": "> 0" },
      "source": { "type": "file", "path": "demo/replies.md", "pattern": "^- (?<date>\\d{4}-\\d{2}-\\d{2}) ", "window": "today" }
    },
    "since_reply": {
      "label": "idle", "format": "days", "tone": { "red": ">= 5", "amber": ">= 2", "green": ">= 0" },
      "source": { "type": "file", "path": "demo/replies.md", "pattern": "^- (?<date>\\d{4}-\\d{2}-\\d{2}) ", "measure": "days_since" }
    },
    "next_piece": {
      "label": "next piece", "template": "Finish {value}", "empty": "Plan a new piece.",
      "source": { "type": "folder", "path": "demo/posts", "where": { "status": ["planned", "filmed"] }, "measure": "first", "field": "title", "sort": { "field": "status", "rank": ["filmed", "planned"] } }
    },
    "next_deal": {
      "label": "next deal", "template": "Reply to {value}", "sensitive": true, "empty": "Deals clear.",
      "source": { "type": "json", "path": "demo/deals.json", "key": "deals", "where": { "status": "open" }, "measure": "first", "field": "brand", "sort": { "field": "last_inbound" } }
    }
  }
}
